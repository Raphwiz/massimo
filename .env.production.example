# Copy to .env.production on the VPS. Never commit the real file.
NODE_ENV=production
ALLOWED_ORIGINS=https://portal.stdorothyschool.ac.ke

POSTGRES_DB=st_dorothy_school
POSTGRES_USER=st_dorothy_app
POSTGRES_PASSWORD=replace-with-a-long-unique-database-password

INITIAL_PORTAL_PASSWORD=replace-with-a-unique-temporary-portal-password
SYSTEM_ADMIN_EMAIL=system-admin@stdorothyschool.ac.ke
SYSTEM_ADMIN_INITIAL_PASSWORD=replace-with-a-different-unique-admin-password

# Add only when the school is ready to connect approved providers.
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_PASSKEY=
SMS_API_KEY=
SMTP_HOST=
SMTP_USER=
